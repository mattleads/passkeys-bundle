{
    "name": "@mattleads/passkeys-bundle",
    "description": "Stimulus controllers for mattleads/passkeys-bundle: hybrid passkey/password login with conditional UI, passkey registration, confirm dialogs.",
    "license": "MIT",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/hybrid_login_controller.js",
    "symfony": {
        "controllers": {
            "hybrid-login": { "main": "dist/hybrid_login_controller.js", "fetch": "eager", "enabled": true },
            "passkey": { "main": "dist/passkey_controller.js", "fetch": "lazy", "enabled": true },
            "confirm": { "main": "dist/confirm_controller.js", "fetch": "lazy", "enabled": true }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0",
            "@simplewebauthn/browser": "^13.0.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "@simplewebauthn/browser": "^13.0.0"
    }
}
